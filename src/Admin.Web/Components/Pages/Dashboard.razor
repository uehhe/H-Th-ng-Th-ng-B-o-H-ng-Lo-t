@page "/"
@inject CampaignApiClient ApiClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IAsyncDisposable

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard Quản Trị
        </h2>
        <p class="text-muted mb-0">Giám sát tổng quan các chiến dịch gửi thông báo hàng loạt thời gian thực</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @(isSignalRConnected ? "bg-success-subtle text-success border border-success" : "bg-secondary-subtle text-secondary border") d-flex align-items-center gap-1 py-2 px-3">
            @if (isSignalRConnected)
            {
                <span class="pulse-live"></span>
                <span>SignalR Trực tiếp</span>
            }
            else
            {
                <i class="bi bi-wifi-off"></i>
                <span>SignalR Ngoại tuyến</span>
            }
        </span>
        <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" title="Làm mới dữ liệu">
            <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
        </button>
        <a href="/campaigns/create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Tạo chiến dịch mới
        </a>
    </div>
</div>

<!-- KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng Chiến Dịch</div>
                        <div class="fs-2 fw-bold text-primary mt-1">@campaigns.Count</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-megaphone fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đã Gửi Thành Công</div>
                        <div class="fs-2 fw-bold text-success mt-1">@totalSent</div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đang Chờ Xử Lý</div>
                        <div class="fs-2 fw-bold text-warning mt-1">@totalPending</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card metric-card danger h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Gửi Thất Bại (Lỗi)</div>
                        <div class="fs-2 fw-bold text-danger mt-1">@totalFailed</div>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                        <i class="bi bi-x-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Alert message if any -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @alertClass alert-dismissible fade show mb-4" role="alert">
        <i class="bi @alertIcon me-2"></i>@alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<!-- Campaigns List Table -->
<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-list-task text-primary me-2"></i>Danh Sách Chiến Dịch
        </h5>
        <div class="input-group" style="max-width: 300px;">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control bg-light border-start-0" placeholder="Tìm kiếm chiến dịch..." @bind="searchTerm" @bind:event="oninput" />
        </div>
    </div>
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <p class="text-muted mt-2 mb-0">Đang tải danh sách chiến dịch...</p>
            </div>
        }
        else if (filteredCampaigns.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted display-4"></i>
                <p class="text-muted mt-3 mb-2">Chưa có chiến dịch nào được tạo.</p>
                <a href="/campaigns/create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Tạo chiến dịch đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 5%;">#</th>
                            <th scope="col" style="width: 25%;">Tiêu Đề</th>
                            <th scope="col" style="width: 10%;">Kênh</th>
                            <th scope="col" style="width: 15%;">Trạng Thái</th>
                            <th scope="col" style="width: 20%;">Tiến Độ (P / S / F)</th>
                            <th scope="col" style="width: 12%;">Thời Gian Tạo</th>
                            <th scope="col" class="text-end" style="width: 13%;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < filteredCampaigns.Count; i++)
                        {
                            var c = filteredCampaigns[i];
                            var total = c.PendingCount + c.SentCount + c.FailedCount;
                            var pct = total > 0 ? (double)(c.SentCount + c.FailedCount) / total * 100 : 0;
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td>
                                    <div class="fw-bold">@c.Title</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 260px;">@c.Content</small>
                                </td>
                                <td>
                                    @switch (c.Channel)
                                    {
                                        case "Email":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <i class="bi bi-envelope me-1"></i>Email
                                            </span>
                                            break;
                                        case "SMS":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-chat-text me-1"></i>SMS
                                            </span>
                                            break;
                                        case "Push":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                <i class="bi bi-bell me-1"></i>Push
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@c.Channel</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (c.Status)
                                    {
                                        case "Completed":
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Processing</span>
                                            break;
                                        case "Draft":
                                        default:
                                            <span class="badge bg-secondary"><i class="bi bi-file-earmark me-1"></i>Draft</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span><strong class="text-warning">@c.PendingCount</strong> P / <strong class="text-success">@c.SentCount</strong> S / <strong class="text-danger">@c.FailedCount</strong> F</span>
                                        <span>@pct.ToString("F0")%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        @if (total > 0)
                                        {
                                            var sentPct = (double)c.SentCount / total * 100;
                                            var failPct = (double)c.FailedCount / total * 100;
                                            <div class="progress-bar bg-success" style="width: @sentPct%"></div>
                                            <div class="progress-bar bg-danger" style="width: @failPct%"></div>
                                        }
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (c.Status == "Draft")
                                        {
                                            <button class="btn btn-outline-success" title="Kích hoạt gửi" @onclick="() => StartCampaign(c.Id)">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        }
                                        @if (c.FailedCount > 0)
                                        {
                                            <button class="btn btn-outline-warning text-dark" title="Thử lại các job lỗi" @onclick="() => RetryCampaign(c.Id)">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        }
                                        <a href="/campaigns/@c.Id" class="btn btn-outline-primary" title="Xem chi tiết &amp; giám sát">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<CampaignDto> campaigns = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string? alertMessage;
    private string alertClass = "alert-info";
    private string alertIcon = "bi-info-circle";

    private HubConnection? hubConnection;
    private bool isSignalRConnected => hubConnection?.State == HubConnectionState.Connected;

    private int totalSent => campaigns.Sum(c => c.SentCount);
    private int totalPending => campaigns.Sum(c => c.PendingCount);
    private int totalFailed => campaigns.Sum(c => c.FailedCount);

    private List<CampaignDto> filteredCampaigns => string.IsNullOrWhiteSpace(searchTerm)
        ? campaigns
        : campaigns.Where(c => c.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                            || c.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await SetupSignalRAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            campaigns = await ApiClient.GetCampaignsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Không thể tải danh sách chiến dịch: {ex.Message}", "alert-danger", "bi-exclamation-triangle");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            var hubUrl = Configuration["SignalRHubUrl"]
                ?? Environment.GetEnvironmentVariable("SIGNALR_HUB_URL")
                ?? "http://localhost:5000/hubs/campaign";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<CampaignDto>("GlobalProgressUpdated", (updatedDto) =>
            {
                var index = campaigns.FindIndex(c => c.Id == updatedDto.Id);
                if (index >= 0)
                {
                    campaigns[index] = updatedDto;
                }
                else
                {
                    campaigns.Insert(0, updatedDto);
                }
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] SignalR connection notice: {ex.Message}");
        }
    }

    private async Task StartCampaign(Guid id)
    {
        var ok = await ApiClient.StartCampaignAsync(id);
        if (ok)
        {
            ShowAlert("Đã kích hoạt chiến dịch! Các worker đang xử lý thông báo.", "alert-success", "bi-check-circle");
            await LoadDataAsync();
        }
        else
        {
            ShowAlert("Không thể kích hoạt chiến dịch. Vui lòng thử lại.", "alert-danger", "bi-x-circle");
        }
    }

    private async Task RetryCampaign(Guid id)
    {
        var ok = await ApiClient.RetryCampaignAsync(id);
        if (ok)
        {
            ShowAlert("Đang yêu cầu gửi lại các job thất bại...", "alert-warning", "bi-arrow-repeat");
            await LoadDataAsync();
        }
        else
        {
            ShowAlert("Thử lại job lỗi thất bại.", "alert-danger", "bi-x-circle");
        }
    }

    private void ShowAlert(string message, string cssClass, string icon)
    {
        alertMessage = message;
        alertClass = cssClass;
        alertIcon = icon;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
